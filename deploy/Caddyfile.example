# Reference Caddy configuration for print.metalix.in
# ----------------------------------------------------
# Live in production since 2026-08-12 (replaced nginx; see deploy/nginx.conf.example,
# kept for rollback). Caddy provisions and renews the Let's Encrypt cert for the domain(s)
# below automatically; no certbot/cron step is needed.
#
# This file mirrors /etc/caddy/Caddyfile on the VM. To reapply after an edit:
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
#
# metalix.in (bare apex) is included here too as of 2026-08-14: AdSense's Sites
# feature verifies ownership at the root domain, not per-subdomain, so its
# crawler hits metalix.in directly rather than print.metalix.in. The apex used
# to point at an unrelated, unaffiliated business's VM (deliberately terminated
# for cost) — its A record was repointed here specifically to satisfy that
# crawl. Canonical tags in the app already point every page at
# https://print.metalix.in/..., so this doesn't create duplicate-content SEO
# issues; it just means the same app also answers for the apex hostname.

print.metalix.in, metalix.in {
    # Unlike nginx, Caddy logs nothing by default — this was a blind spot for
    # several days post-migration. /var/log/caddy/ is created (caddy:caddy) by
    # the Debian/Ubuntu package, but if access.log doesn't already exist owned
    # by that user, Caddy will fail to reload with "permission denied" until
    # you `chown caddy:caddy` it first.
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 14
            roll_keep_for 336h
        }
    }

    # Compress text responses. woff2/png/jpg are already compressed, so they are
    # intentionally excluded (gzipping them wastes CPU for ~0 bytes saved).
    encode gzip

    # Long-cache the self-hosted, content-stable fonts. This mirrors the
    # Cache-Control Express already emits; keeping it here means the header is
    # correct even if a font is ever served directly by Caddy.
    @fonts path /fonts/*
    handle @fonts {
        header Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin "*"
        reverse_proxy 127.0.0.1:5050
    }

    # Everything else proxies to the Node app, which sets its own Cache-Control
    # (max-age=0/no-cache for HTML, long max-age for logos and hashed assets).
    handle {
        reverse_proxy 127.0.0.1:5050
    }
}
